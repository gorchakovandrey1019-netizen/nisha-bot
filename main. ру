import os
import threading
from flask import Flask
from telegram import Update
from telegram.ext import ApplicationBuilder, ContextTypes, CommandHandler, MessageHandler, filters
import google.generativeai as genai

# --- ТЕПЕРЬ КЛЮЧИ БЕРУТСЯ ИЗ НАСТРОЕК RENDER ---
# Мы не пишем их прямо в коде, чтобы GitHub не ругался на безопасность
TELEGRAM_TOKEN = os.environ.get("TELEGRAM_TOKEN")
GEMINI_API_KEY = os.environ.get("GEMINI_API_KEY")

# Настройка Gemini
genai.configure(api_key=GEMINI_API_KEY)
model = genai.GenerativeModel(
    model_name='gemini-1.5-flash',
    system_instruction=(
        "Ты — профессиональный бизнес-аналитик и эксперт по стартапам. "
        "Твоя задача — помогать пользователям находить прибыльные ниши и идеи для бизнеса. "
        "Отвечай структурированно, кратко и по делу. "
        "Обязательно указывай: целевую аудиторию, проблему клиента, суть решения и примерную модель монетизации. "
        "Не отвечай на вопросы, не связанные с бизнесом, стартапами, маркетингом или экономикой."
    )
)

# --- Блок для работы на Render ---
app = Flask(__name__)

@app.route('/')
def home():
    return "Bot is running!"

def run_flask():
    port = int(os.environ.get('PORT', 8080))
    app.run(host='0.0.0.0', port=port)

# --- Логика бота ---
async def start(update: Update, context: ContextTypes.DEFAULT_TYPE):
    await update.message.reply_text(
        "Привет! Я твой личный бизнес-консультант. 🤖💼\n"
        "Напиши мне, в какой сфере ты хочешь запустить стартап."
    )

async def handle_message(update: Update, context: ContextTypes.DEFAULT_TYPE):
    user_text = update.message.text
    await update.message.reply_text("Анализирую рынок и ищу идеи... ⏳")
    try:
        response = model.generate_content(user_text)
        await update.message.reply_text(response.text)
    except Exception as e:
        await update.message.reply_text(f"Произошла ошибка: {e}")

if __name__ == '__main__':
    threading.Thread(target=run_flask, daemon=True).start()

    app_bot = ApplicationBuilder().token(TELEGRAM_TOKEN).build()
    app_bot.add_handler(CommandHandler("start", start))
    app_bot.add_handler(MessageHandler(filters.TEXT & ~filters.COMMAND, handle_message))
    
    print("Бот запущен!")
    app_bot.run_polling()